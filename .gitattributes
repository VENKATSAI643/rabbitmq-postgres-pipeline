# Normalize line endings to LF in the repository for cross-platform consistency
* text=auto eol=lf

# Python files — always LF
*.py    text eol=lf

# Markdown and text files — always LF
*.md    text eol=lf
*.txt   text eol=lf
*.cfg   text eol=lf
*.ini   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf

# Shell scripts — always LF (critical for WSL/Linux)
*.sh    text eol=lf

# Windows batch files — always CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Binary files — no line ending conversion
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.zip   binary
*.gz    binary
*.tar   binary
